{
    "compilerOptions": {
        "moduleResolution": "bundler",
        "target": "ES2022",
        "module": "ESNext",
        "lib": ["ES2022", "DOM"],
        "rootDir": "src",
        "outDir": "dist",
        "declaration": true,
        "strict": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "skipLibCheck": true,
        "noEmitOnError": false
    }
}
