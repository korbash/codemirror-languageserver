{
    "name": "codemirror-languageserver",
    "version": "1.12.1",
    "type": "module",
    "description": "Language Server Plugin for CodeMirror 6",
    "exports": {
        ".": {
            "import": "./dist/index.js"
        }
    },
    "types": "dist/index.d.ts",
    "sideEffects": false,
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "clean": "rm -rf dist",
        "build": "tsc --project tsconfig.json",
        "format": "prettier --write .",
        "prepare": "npm run build",
        "test": "npm run build && node dist/run-tests.js",
        "test:quick": "npm run build && node dist/run-tests.js --quick",
        "test:full": "npm run build && node dist/run-tests.js",
        "sanity": "npm run build && node dist/sanity-check.js",
        "test:simple": "npm run build && node dist/test_simple_lsp.js",
        "test:minimal": "npm run build && node dist/test_minimal.js",
        "test:lsp": "npm run test:minimal"
    },
    "author": {
        "name": "Mahmud Ridwan",
        "email": "m@hjr265.me",
        "url": "https://hjr265.me"
    },
    "homepage": "https://github.com/FurqanSoftware/codemirror-languageserver",
    "bugs": {
        "url": "https://github.com/FurqanSoftware/codemirror-languageserver/issues"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/FurqanSoftware/codemirror-languageserver.git"
    },
    "license": "BSD-3-Clause",
    "devDependencies": {
        "@types/loglevel": "^1.5.4",
        "@types/node": "^24.0.1",
        "prettier": "^3.5.3",
        "typescript": "^5.8.3",
        "vscode-languageserver": "^9.0.1"
    },
    "peerDependencies": {
        "@codemirror/autocomplete": "^6.18.6",
        "@codemirror/lint": "^6.8.5",
        "@codemirror/state": "^6.5.2",
        "@codemirror/view": "^6.37.1",
        "@open-rpc/client-js": "^1.8.1",
        "loglevel": "^1.9.2",
        "marked": "^15.0.12",
        "vscode-languageserver-protocol": "^3.17.5"
    },
    "prettier": {
        "tabWidth": 4,
        "singleQuote": true
    }
}
